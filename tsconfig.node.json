{
  "compilerOptions": {
    "composite": true,
    "skipLibCheck": true,
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": ".tsbuild",
    "rootDir": ".",
    "types": ["node"],
    "strict": true
  },
  "include": ["vite.config.ts", "vitest.config.ts", "server", "api"]
}
